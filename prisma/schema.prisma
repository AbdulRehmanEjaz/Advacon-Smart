generator client {
  provider = "prisma-client-js"
  engineType = "client"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum Role {
  ADMIN
  FOREMAN
}
enum SubmissionStatus {
  WAITING
  APPROVED
  RETURNED
  REJECTED
}
model User {
  id String @id @default(cuid())
  name String
  role Role @default(FOREMAN)
  pinHash String
  pinLookup String @unique
  defaultPin Boolean @default(true)
  active Boolean @default(true)
  archivedAt DateTime?
  lastLogin DateTime?
  failedLoginCount Int @default(0)
  lockedUntil DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions Session[]
  submissions DailySubmission[]
  approvals Approval[]
  adjustments Adjustment[]
}
model Session {
  id String @id
  userId String
  user User @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([expiresAt])
}
model AuthThrottle {
  id String @id
  failures Int @default(0)
  lockedUntil DateTime?
  updatedAt DateTime @updatedAt
}
model Project {
  id String @id @default("tree-project")
  name String @default("Trees Translocation Project")
  createdAt DateTime @default(now())
  settings ProjectSettings?
  zones Zone[]
  packages WorkPackage[]
}
model ProjectSettings {
  projectId String @id
  project Project @relation(fields: [projectId], references: [id])
  designCapacity Int @default(13524)
  translocationTarget Int @default(10000)
  translocationTargetIsApproximate Boolean @default(true)
  newTreeTarget Int @default(3500)
  irrigationTarget Decimal @default(17220) @db.Decimal(14, 3)
  blockTarget Int @default(19)
  rowTarget Int @default(312)
  postTarget Int @default(1560)
  valveTarget Int @default(19)
  decoderTarget Int @default(19)
  productivityMin Int @default(250)
  productivityMax Int @default(300)
  amberVariance Decimal @default(-2) @db.Decimal(8, 3)
  redVariance Decimal @default(-5) @db.Decimal(8, 3)
  pendingHours Int @default(48)
  updatedAt DateTime @updatedAt
}
model Zone {
  id String @id
  projectId String @default("tree-project")
  project Project @relation(fields: [projectId], references: [id])
  capacity Int
  spacing String
  blocks Block[]
}
model Block {
  id String @id
  zoneId String
  zone Zone @relation(fields: [zoneId], references: [id])
  name String
  capacity Int?
  irrigationTarget Decimal? @db.Decimal(14, 3)
  supportRows Int?
  hold Boolean @default(false)
  submissions DailySubmission[]
  inspections Inspection[]
}
model WorkPackage {
  id String @id
  projectId String @default("tree-project")
  project Project @relation(fields: [projectId], references: [id])
  name String
  weight Decimal @db.Decimal(10, 6)
  order Int
  activities Activity[]
  submissions DailySubmission[]
}
model Activity {
  id String @id
  packageId String
  package WorkPackage @relation(fields: [packageId], references: [id])
  name String
  unit String
  targetKey String
  target Decimal? @db.Decimal(14, 3)
  weight Decimal @db.Decimal(10, 6)
  items DailySubmissionItem[]
  schedule ScheduleActivity?
}
model ScheduleActivity {
  activityId String @id
  activity Activity @relation(fields: [activityId], references: [id])
  start DateTime @db.Date
  finish DateTime @db.Date
}
model DailySubmission {
  id String @id @default(cuid())
  requestKey String @unique
  supervisorId String
  supervisor User @relation(fields: [supervisorId], references: [id])
  workDate DateTime @db.Date
  blockId String
  block Block @relation(fields: [blockId], references: [id])
  packageId String
  package WorkPackage @relation(fields: [packageId], references: [id])
  batchNumber String?
  remarks String @default("")
  overrideReason String?
  status SubmissionStatus @default(WAITING)
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items DailySubmissionItem[]
  photos SubmissionPhoto[]
  approvals Approval[]
  @@index([status, createdAt])
  @@index([supervisorId, workDate])
}
model DailySubmissionItem {
  id String @id @default(cuid())
  submissionId String
  submission DailySubmission @relation(fields: [submissionId], references: [id])
  activityId String
  activity Activity @relation(fields: [activityId], references: [id])
  quantity Decimal @db.Decimal(14, 3)
  adjustments Adjustment[]
  @@unique([submissionId, activityId])
}
model SubmissionPhoto {
  id String @id @default(cuid())
  submissionId String
  submission DailySubmission @relation(fields: [submissionId], references: [id])
  name String
  mime String
  bytes Bytes
  createdAt DateTime @default(now())
}
model Approval {
  id String @id @default(cuid())
  submissionId String
  submission DailySubmission @relation(fields: [submissionId], references: [id])
  reviewerId String
  reviewer User @relation(fields: [reviewerId], references: [id])
  decision SubmissionStatus
  comment String
  version Int
  createdAt DateTime @default(now())
  @@unique([submissionId, version])
}
model Adjustment {
  id String @id @default(cuid())
  requestKey String @unique
  itemId String
  item DailySubmissionItem @relation(fields: [itemId], references: [id])
  authorId String
  author User @relation(fields: [authorId], references: [id])
  quantity Decimal @db.Decimal(14, 3)
  reason String
  createdAt DateTime @default(now())
}
model Inspection {
  id String @id @default(cuid())
  number String @unique
  blockId String
  block Block @relation(fields: [blockId], references: [id])
  type String
  inspector String
  result String
  date DateTime @db.Date
  remarks String @default("")
  firstAttempt Boolean @default(true)
  createdAt DateTime @default(now())
  observations Observation[]
}
model Observation {
  id String @id @default(cuid())
  inspectionId String
  inspection Inspection @relation(fields: [inspectionId], references: [id])
  description String
  responsible String
  dueDate DateTime @db.Date
  closedAt DateTime?
  createdAt DateTime @default(now())
}
model AuditLog {
  id String @id @default(cuid())
  userId String?
  role String?
  action String
  entityType String
  entityId String?
  before Json?
  after Json?
  ipHash String?
  createdAt DateTime @default(now())
  @@index([createdAt])
}
