# Temporary only for optional PostgreSQL-to-D1 data export. Not used by the Worker.
DATABASE_URL=
# Temporary backup/migration reference only. Not used by the Worker.
DIRECT_DATABASE_URL=
# Same secret as the LIVE Worker, at least 32 characters. Never rotate automatically.
SESSION_SECRET=
# Worker-only runtime login secrets. Keep out of source control and client code.
ADMIN_PIN=
SUPERVISOR_PIN=
# Legacy setting retained during migration; the D1 runtime does not read it.
TRUST_CLOUDFLARE_IP=false
# Set to the verified HTTPS deployment origin before publishing social metadata.
PUBLIC_ORIGIN=
