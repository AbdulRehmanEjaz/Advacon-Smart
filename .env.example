# Worker runtime: standard pooled postgres:// Prisma Postgres connection.
DATABASE_URL=
# Local/migration only: direct Prisma Postgres connection (not pooled).
# Not needed in the live Cloudflare Worker. db:setup can prompt privately.
DIRECT_DATABASE_URL=
# Same secret as the LIVE Worker, at least 32 characters. Never rotate automatically.
SESSION_SECRET=
# Seed-only, distinct three-digit PINs; never needed in the live Worker.
INITIAL_ADMIN_PIN=
INITIAL_FOREMAN_PIN=
# Enable only when hosted behind Cloudflare, which overwrites this IP header.
TRUST_CLOUDFLARE_IP=false
# Set to the verified HTTPS deployment origin before publishing social metadata.
PUBLIC_ORIGIN=
