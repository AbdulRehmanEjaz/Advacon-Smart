# Runtime PostgreSQL access over HTTPS (Prisma Accelerate).
DATABASE_URL=
# Direct PostgreSQL connection for migrations and seed; do not expose to browser.
DIRECT_DATABASE_URL=
# Generate a random secret of at least 32 characters; never commit a real value.
SESSION_SECRET=
# Seed-only, distinct three-digit PINs; use the initial values from your project brief.
INITIAL_ADMIN_PIN=
INITIAL_FOREMAN_PIN=
# Enable only when hosted behind Cloudflare, which overwrites this IP header.
TRUST_CLOUDFLARE_IP=false
# Set to the verified HTTPS deployment origin before publishing social metadata.
PUBLIC_ORIGIN=
